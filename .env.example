# ─────────────────────────────────────────────────────────
# Aroko Backend — Plantilla de variables de entorno
# Copia este archivo como .env y rellena con valores reales
# NUNCA commitees el archivo .env con secretos reales
# ─────────────────────────────────────────────────────────

# Entorno de ejecución
NODE_ENV=production

# Puerto del servidor
PORT=3000

# URL base pública (para construir URLs de imágenes, uploads, etc.)
BASE_URL=https://api.tudominio.com

# Orígenes permitidos por CORS (separados por coma)
# Incluye el dominio de Flutter Web y localhost para desarrollo
ALLOWED_ORIGINS=https://tudominio.com

# ─────────────────────────────────────────────────────────
# PostgreSQL (Neon / auto-hospedado)
# Obten este valor del panel de tu proveedor de PostgreSQL
# ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USUARIO:PASSWORD@host:5432/dbname?sslmode=require

# ─────────────────────────────────────────────────────────
# JWT — usar un string largo y aleatorio
# Genera con: openssl rand -base64 48
# ─────────────────────────────────────────────────────────
JWT_SECRET=

# Expiración del token (ej: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# ─────────────────────────────────────────────────────────
# Email (recuperación de contraseña, notificaciones)
# Se recomienda Gmail App Password o SMTP de un provider
# ─────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# Mailgun (opcional, alternativa a Gmail)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
